LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# Choose a currently available model in your Google AI Studio account.
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_SIMILARITY=0.30
MAX_FILE_MB=20
MAX_DOCUMENTS=20
MAX_PAGES=500
MAX_CHUNKS=10000
HISTORY_TURNS=6
TIMEOUT_SECONDS=45
# Optional pacing for accounts with low request-per-minute quotas.
LLM_MIN_INTERVAL_SECONDS=0
